# ─────────────────────────────────────────────────────────────────
# YM-TRANSIT ERP — Variables d'environnement pour Coolify
# Définissez ces variables dans Coolify : Service → Environment Variables
# ─────────────────────────────────────────────────────────────────

# Clé API Gemini — obtenez la vôtre gratuitement sur aistudio.google.com/apikey
GEMINI_API_KEY=votre_cle_gemini_ici

# URL publique de l'application (sans barre oblique finale)
# Coolify l'injecte automatiquement — mettez à jour après le premier déploiement
APP_URL=https://votre-app.votre-domaine.com

# Base de données PostgreSQL (Coolify : + New Resource > PostgreSQL, copiez son « Internal URL »)
DATABASE_URL=postgresql://ym:motdepasse@postgres:5432/ymtransit

# Ancienne base SQLite à reprendre automatiquement au premier démarrage (si PostgreSQL est vide).
# Par défaut /app/data/prod.db : gardez le volume /app/data monté, il ne sera jamais modifié.
# SQLITE_IMPORT_PATH=/app/data/prod.db

# --- Sauvegardes automatiques (une par jour à partir de 2 h, visibles dans Administration > Sauvegardes) ---
# BACKUP_PATH=/app/data/backups   # dossier des sauvegardes (sur le volume persistant)
# BACKUP_KEEP=14                  # nombre de sauvegardes gardées
# BACKUP_DISABLED=true            # pour couper les sauvegardes de l'ERP

# Plateforme de gestion des camions (lien dans le menu). Se règle aussi dans Administration › Plateformes externes.
# TRANSPORT_URL=https://accounting.ym-transit.com

# Mots de passe : après chaque mise à jour de l'ERP, chaque utilisateur doit choisir un nouveau mot de passe
# à sa prochaine connexion. Mettez false pour couper ce renouvellement.
# PASSWORD_RENEW_ON_UPDATE=true
# APP_VERSION=          # facultatif : sinon la version est détectée automatiquement à chaque build

# Port — Coolify le détecte automatiquement depuis EXPOSE dans le Dockerfile
PORT=3000

# Secret de session — changez ceci pour une longue chaîne aléatoire !
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changez-ceci-pour-une-longue-chaine-aleatoire-secrete

# Chemin des fichiers uploadés dans le conteneur Docker
UPLOADS_PATH=/app/uploads

# Connexion de démonstration sans mot de passe (/demo-login).
# Désactivée par défaut et TOUJOURS désactivée quand NODE_ENV=production.
# ENABLE_DEMO_LOGIN=true

# --- Application installable et notifications push ---
# Adresse publique de l'ERP (utilisée dans les liens de suivi envoyés aux clients)
APP_URL=https://erp.ym-transit.cm
# Clés VAPID des notifications push. Si absentes, elles sont générées une fois
# et gardées dans le dossier de la base (/app/data/vapid-keys.json).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ym-transit.cm

# --- E-mails (facultatif) : messages aux clients et rappels de visa ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="YM-TRANSIT <no-reply@ym-transit.cm>"

# --- Rappels automatiques ---
# REMINDER_INTERVAL_MINUTES=15   # fréquence des vérifications
# VISA_REMINDER_HOURS=12         # rappel si un bon attend un visa depuis plus longtemps
# JUSTIFICATION_DAYS=7           # rappel si une avance n'est pas justifiée (bon réel) après N jours
# INTERNAL_PDG_THRESHOLD=500000   # dépense interne : visa du PDG exigé à partir de ce montant (F)
# DISABLE_REMINDERS=true         # pour couper les rappels
