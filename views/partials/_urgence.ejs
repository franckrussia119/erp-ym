<%# Choix obligatoire à l'émission de tout bon provisoire (dossier ou dépense interne) %>
<label class="form-label">Urgence <span class="text-danger">*</span></label>
<div class="seg-pick urg-pick">
  <label><input type="radio" name="urgent" value="0" required><span><i class="bi bi-clock"></i>Non urgent</span></label>
  <label class="urg-on"><input type="radio" name="urgent" value="1"><span><i class="bi bi-lightning-charge-fill"></i>Urgent</span></label>
</div>
