<script>
document.addEventListener('click', function (ev) {
  var btn = ev.target.closest('.visa-card [data-act], .visa-list [data-act]');
  if (!btn) return;
  var id = btn.dataset.id, act = btn.dataset.act, req, recuWin = null;
  var json = function (method, url, body) { return fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined }); };
  if (act === 'tick') {
    req = json('POST', '/bons/provisoir/' + id + '/tick', { tick: btn.dataset.key });
  } else if (act === 'approve') {
    if (!confirm('Payer ' + btn.dataset.montant + ' F pour le bon ' + btn.dataset.num + ' ? La sortie sera inscrite dans la caisse et le reçu à faire signer s\'ouvrira.')) return;
    var papier = prompt('N° du reçu papier signé par le bénéficiaire (vous pourrez aussi le saisir plus tard, sur le reçu) :', '');
    if (papier === null) return;
    // Ouvert tout de suite (sinon le navigateur bloque la fenêtre), puis dirigé vers le reçu après le paiement
    recuWin = window.open('', '_blank');
    req = json('PATCH', '/bons/provisoir/' + id + '/approuver', { recu_papier: papier.trim() });
  } else if (act === 'order') {
    if (!confirm('Ordonner à la caisse de payer le bon ' + btn.dataset.num + ' sans attendre les autres visas ? Votre nom sera enregistré.')) return;
    req = json('POST', '/bons/provisoir/' + id + '/ordre', {});
  } else if (act === 'order-cancel') {
    req = json('POST', '/bons/provisoir/' + id + '/ordre', { annuler: '1' });
  } else if (act === 'reject') {
    var modif = btn.dataset.type === 'MODIFICATION';
    var motif = prompt((modif ? 'Rejet pour modification du bon ' : 'Rejet définitif du bon ') + btn.dataset.num + '. Motif :' + (modif ? ' (ce qu\'il faut corriger)' : ''));
    if (!motif || !motif.trim()) return;
    req = json('PATCH', '/bons/provisoir/' + id + '/rejeter', { motif_rejet: motif.trim(), type: btn.dataset.type });
  }
  if (!req) return;
  btn.disabled = true;
  req.then(function (r) { return r.json(); }).then(function (d) {
    if (d.ok === false) { if (recuWin) recuWin.close(); showToast('Action impossible', d.message || 'Erreur', null, 'err'); btn.disabled = false; return; }
    if (d.recu) { if (recuWin) recuWin.location = d.recu + '?print=1'; else window.open(d.recu + '?print=1', '_blank'); }
    showToast('C\'est fait', d.message || 'Bon mis à jour.', null, 'ok');
    if (window.ymLiveRefresh) window.ymLiveRefresh(true); else setTimeout(function () { location.reload(); }, 600);
  }).catch(function () { if (recuWin) recuWin.close(); showToast('Erreur réseau', 'Réessayez.', null, 'err'); btn.disabled = false; });
});
</script>
