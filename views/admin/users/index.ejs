    { key: "dga", label: "Directeur Général Adjoint", desc: "Visa des bons et suivi de l'activité", icon: "bi-person-badge", badge: "bg-dark" },
    { key: "daf", label: "Directeur Administratif et Financier", desc: "Validation financière des demandes, dépenses et paie", icon: "bi-bank2", badge: "bg-dark" },
    { key: "secretariat", label: "Secrétariat Administratif", desc: "Suivi des tiers, création initiale de dossiers de transit", icon: "bi-building-fill", badge: "bg-primary text-white" },
    { key: "validation", label: "Chargé de Validation", desc: "Contrôle d'intégrité et validation douanière administrative", icon: "bi-shield-check", badge: "bg-success text-white" },
    { key: "guce", label: "Agent Douane GUCE", desc: "Liaisons avec le Guichet Unique pour le commerce extérieur", icon: "bi-cash-coin", badge: "bg-info text-dark" },
    { key: "acconage", label: "Service Acconage", desc: "Enregistrement des navires, opérations portuaires et bons d'avance", icon: "bi-ship", badge: "bg-primary-subtle text-primary border" },
    { key: "enlevement", label: "Service Enlèvement et Livraison", desc: "Opérations de dédouanement physiques, livraison et bons de caisse", icon: "bi-truck", badge: "bg-warning text-dark" },
    { key: "direction", label: "Direction de Caisse", desc: "Visa, approbation budgétaire des dépenses et audit analytique", icon: "bi-person-workspace", badge: "bg-danger text-white" },
    { key: "agent_payeur", label: "Trésorier / Agent Payeur", desc: "Règlement des bons approuvés, gestion de caisse et monétique", icon: "bi-wallet2", badge: "bg-success-subtle text-success border" },
    { key: "finances", label: "Administration Financière", desc: "Génération de devis, factures clients et conformité fiscale", icon: "bi-bank", badge: "bg-dark" },
    { key: "comptable_ops", label: "Comptabilité Opérationnelle", desc: "Clôtures des dossiers, bilans des charges d'expédition d'avance", icon: "bi-calculator-fill", badge: "bg-secondary text-white" },
    { key: "super_admin", label: "Super Administrateur", desc: "Gouvernance système totale, sécurité et création de collaborateurs", icon: "bi-cpu-fill", badge: "bg-dark" },
    { key: "comptable", label: "Comptabilité Générale", desc: "Saisie journalière de factures fournisseurs, grand livre", icon: "bi-briefcase", badge: "bg-indigo text-dark" },
    { key: "commercial", label: "Service Commercial", desc: "Prospection client, négociation douanière, gestion du listing", icon: "bi-cart-fill", badge: "bg-purple text-white" },
    { key: "operationnel", label: "Exploitant transit", desc: "Maintenance générale des dossiers transit standards", icon: "bi-gear-wide-connected", badge: "bg-light text-slate-800 border" },
    { key: "magasinier", label: "Gestionnaire Entrepôt", desc: "Contrôle des stocks de marchandises et magasins généraux", icon: "bi-box-seam-fill", badge: "bg-teal-700 text-white" },
    { key: "rh", label: "Ressources Humaines", desc: "Gestion des employés, paies et traitement des congés", icon: "bi-people-fill", badge: "bg-pink text-white" },
    { key: "facturation", label: "Facturation", desc: "Devis, factures clients et suivi des règlements", icon: "bi-receipt", badge: "bg-dark" },
    { key: "fiscalite", label: "Fiscalité", desc: "Déclarations et conformité fiscale", icon: "bi-percent", badge: "bg-dark" },
    { key: "cloture", label: "Clôture", desc: "Clôture et archivage des dossiers", icon: "bi-archive", badge: "bg-dark" },
    { key: "analyste", label: "Analyste", desc: "Analyses, rapports et tableaux de bord", icon: "bi-graph-up", badge: "bg-dark" },
    { key: "auditeur1", label: "Auditeur 1", desc: "Contrôle interne des bons et des dossiers", icon: "bi-search", badge: "bg-dark" },
    { key: "auditeur2", label: "Auditeur 2", desc: "Second niveau de contrôle interne", icon: "bi-search", badge: "bg-dark" },
    { key: "lecture", label: "Auditeur / Lecture Seule", desc: "Consultation intégrale de l'ERP sans droit d'écriture", icon: "bi-eye-fill", badge: "bg-secondary-subtle text-secondary" }
  ];
%>

<!-- ROLE STATS SUMMARY GRID OVERVIEW -->
<div class="row g-3 mb-4 text-start">
  <% rolesDefinition.forEach(role => { %>
    <% 
      const roleUsers = users.filter(u => (u.role === role.key || (role.key === 'validation' && u.role === 'validation_role')));
      const activeCount = roleUsers.filter(u => u.actif).length;
    %>
    <div class="col-sm-6 col-md-4 col-lg-3">
      <div class="card border-0 shadow-sm h-100 rounded-3 transition-all hover:translate-y-[-2px] border-bottom border-3" style="border-color: #cbd5e1 !important;">
        <div class="card-body p-3 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="rounded-circle bg-light text-slate-600 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                <i class="bi <%= role.icon %>"></i>
              </span>
              <span class="badge rounded-pill <%= role.badge %> text-xs font-monospace">
                <%= role.key %>
              </span>
            </div>
            <h6 class="fw-bold mb-1 text-slate-800" style="font-size: 0.9rem;"><%= role.label %></h6>
            <p class="text-slate-500 mb-2" style="font-size: 0.72rem; line-height: 1.25;"><%= role.desc %></p>
          </div>
          <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top border-light">
            <span class="text-xs text-muted">
              <strong><%= roleUsers.length %></strong> compte<%= roleUsers.length > 1 ? 's' : '' %> 
              (<%= activeCount %> actif<%= activeCount > 1 ? 's' : '' %>)
            </span>
            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0.5" style="font-size: 0.7rem;" title="Attribuer ce rôle à un employé" data-bs-toggle="modal" data-bs-target="#assignModal" data-role="<%= role.key %>" data-role-label="<%= role.label %>">
              <i class="bi bi-plus-lg"></i> Assigner
            </button>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<!-- ACCORDION / ROLES GROUPS EXPAND LIST -->
<div class="text-start">
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-bottom py-3">
      <h5 class="mb-0 text-slate-800 fw-bold"><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Détails des Équipes par Rôle</h5>
    </div>
    <div class="card-body p-0">
      <div class="accordion accordion-flush" id="rolesAccordion">
        <% rolesDefinition.forEach((role, rIndex) => { %>
          <% 
            const roleUsers = users.filter(u => (u.role === role.key || (role.key === 'validation' && u.role === 'validation_role')));
          %>
          <div class="accordion-item border-bottom">
            <h2 class="accordion-header" id="heading<%= role.key %>">
              <button class="accordion-button <%= roleUsers.length > 0 ? '' : 'collapsed' %> d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= role.key %>" aria-expanded="<%= roleUsers.length > 0 ? 'true' : 'false' %>" aria-controls="collapse<%= role.key %>" style="background-color: #fafbfc;">
                <div class="d-flex align-items-center flex-wrap gap-2">
                  <span class="rounded-circle bg-light text-slate-700 d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px;">
                    <i class="bi <%= role.icon %>"></i>
                  </span>
                  <strong class="text-slate-800 me-2"><%= role.label %></strong>
                  <span class="badge bg-secondary-subtle text-secondary font-monospace text-xs py-1 px-2 rounded-pill">
                    <%= role.key %>
                  </span>
                </div>
                <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 text-xs me-4 font-monospace">
                  <%= roleUsers.length %> collaborateur<%= roleUsers.length > 1 ? 's' : '' %>
                </span>
              </button>
            </h2>
            <div id="collapse<%= role.key %>" class="accordion-collapse collapse <%= roleUsers.length > 0 ? 'show' : '' %>" aria-labelledby="heading<%= role.key %>" data-bs-parent="#rolesAccordion">
              <div class="accordion-body p-0">
                <% if (roleUsers.length === 0) { %>
                  <div class="p-4 text-muted text-center small">
                    <i class="bi bi-people-fill text-slate-300 me-1.5"></i> Aucun compte actif ou inactif n'est encore assigné au rôle <strong><%= role.label %></strong>.
                    <div class="mt-2 text-center">
                      <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none p-0 fw-bold" data-bs-toggle="modal" data-bs-target="#assignModal" data-role="<%= role.key %>" data-role-label="<%= role.label %>">
                        <i class="bi bi-person-plus-fill me-1"></i>Assigner un employé à ce poste
                      </button>
                    </div>
                  </div>
                <% } else { %>
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                      <thead class="table-light">
                        <tr>
                          <th class="ps-4 py-2 text-muted fw-bold text-xs uppercase" style="width: 25%;">Nom / Prénom</th>
                          <th class="py-2 text-muted fw-bold text-xs uppercase" style="width: 25%;">Adresse Email</th>
                          <th class="py-2 text-muted fw-bold text-xs uppercase" style="width: 15%;">Société / service</th>
                          <th class="py-2 text-muted fw-bold text-xs uppercase" style="width: 13%;">Statut</th>
                          <th class="py-2 text-muted fw-bold text-xs uppercase" style="width: 12%;">Connexion</th>
                          <th class="pe-4 py-2 text-end text-muted fw-bold text-xs uppercase" style="width: 10%;">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% roleUsers.forEach(targetUser => { %>
                          <tr>
                            <td class="ps-4 py-3 fw-medium">
                              <div class="d-flex align-items-center">
                                <div class="rounded-circle text-white bg-slate-400 d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 0.85rem; font-weight: 700;">
                                  <%= (targetUser.prenom ? targetUser.prenom[0] : '') %><%= targetUser.nom[0] %>
                                </div>
                                <div>
                                  <div class="fw-semibold text-slate-800"><%= targetUser.nom %> <%= targetUser.prenom || "" %></div>
                                  <% if (targetUser.force_pwd_change) { %>
                                    <span class="badge bg-warning text-dark font-sans" style="font-size: 0.65rem;">Changement PWD forcé</span>
                                  <% } %>
                                </div>
                              </div>
                            </td>
                            <td class="py-3 text-slate-600 font-monospace text-xs"><%= targetUser.email %></td>
                            <td class="py-3 text-slate-500 font-sans"><%= targetUser.societe %><% if (targetUser.departement) { %><div><span class="dept-chip" style="--d: <%= targetUser.departement.couleur %>"><i class="bi <%= targetUser.departement.icone %>"></i><%= targetUser.departement.nom %></span></div><% } %></td>
                            <td class="py-3">
                              <% if (targetUser.actif) { %>
                                <span class="badge bg-success-subtle text-success py-1 px-2 rounded-pill" style="font-size: 0.72rem;"><i class="bi bi-check-circle me-1"></i>Actif</span>
                              <% } else { %>
                                <span class="badge bg-danger-subtle text-danger py-1 px-2 rounded-pill" style="font-size: 0.72rem;"><i class="bi bi-slash-circle me-1"></i>Désactivé</span>
                              <% } %>
                            </td>
                            <td class="py-3 text-muted small" style="font-size: 0.75rem;">
                              <%= targetUser.last_login ? new Date(targetUser.last_login).toLocaleDateString('fr-FR') : "Jamais" %>
                            </td>
                            <td class="pe-4 py-3 text-end">
                              <div class="d-flex justify-content-end gap-1">
                                <a href="/admin/users/edit/<%= targetUser.id %>" class="btn btn-outline-secondary btn-xs py-1 px-2 rounded-pill" style="font-size: 0.75rem;" title="Modifier">
                                  <i class="bi bi-pencil-square"></i>
                                </a>
                                <form action="/admin/users/toggle/<%= targetUser.id %>" method="POST" class="d-inline" onsubmit="return confirm('Voulez-vous modifier le statut de cet utilisateur ?');">
                                  <button type="submit" class="btn btn-xs py-1 px-2 rounded-pill <%= targetUser.actif ? 'btn-outline-danger' : 'btn-outline-success' %>" style="font-size: 0.75rem;" title="<%= targetUser.actif ? 'Désactiver' : 'Activer' %>">
                                    <i class="bi <%= targetUser.actif ? 'bi-shield-x' : 'bi-shield-check' %>"></i>
                                  </button>
                                </form>
                                <button class="btn btn-outline-warning btn-xs py-1 px-2 rounded-pill text-dark" style="font-size: 0.75rem;" data-bs-toggle="modal" data-bs-target="#resetModal<%= targetUser.id %>" title="Changer mot de passe">
                                  <i class="bi bi-key-fill"></i>
                                </button>
                              </div>

                              <!-- Reset Password Modal -->
                              <div class="modal fade text-start" id="resetModal<%= targetUser.id %>" tabindex="-1" aria-hidden="true" style="text-align: left;">
                                <div class="modal-dialog modal-dialog-centered">
                                  <form action="/admin/users/reset-pwd/<%= targetUser.id %>" method="POST" class="modal-content border-0 shadow">
                                    <div class="modal-header bg-warning py-3">
                                      <h5 class="modal-title text-dark fw-bold"><i class="bi bi-key-fill me-2"></i>Réinitialiser le mot de passe</h5>
                                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                      <p class="text-slate-600 mb-3 small">Réinitialisation pour <strong><%= targetUser.nom %></strong>. L'utilisateur devra obligatoirement changer ce mot de passe temporaire lors de sa prochaine connexion.</p>
                                      <div class="mb-3">
                                        <label class="form-label text-xs fw-bold">Nouveau mot de passe temporaire</label>
                                        <div class="input-group">
                                          <span class="input-group-text bg-white text-muted"><i class="bi bi-shield-lock"></i></span>
                                          <input type="text" name="new_password" class="form-control form-control-sm" placeholder="Entrez un mot de passe solide (ex: YmTransit@<%= targetUser.nom %>2026)" required>
                                        </div>
                                      </div>
                                    </div>
                                    <div class="modal-footer p-3 bg-light border-top-0">
                                      <button type="button" class="btn btn-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Annuler</button>
                                      <button type="submit" class="btn btn-warning rounded-pill px-4 text-dark fw-bold btn-sm">Appliquer la réinitialisation</button>
                                    </div>
                                  </form>
                                </div>
                              </div>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>


<!-- Assigner un rôle à un employé existant -->
<div class="modal fade" id="assignModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable"><form class="modal-content" method="POST" action="/admin/users/assigner" id="assignForm">
    <input type="hidden" name="role" id="assignRole">
    <div class="modal-header"><h5 class="modal-title"><i class="bi bi-person-check me-2"></i>Assigner · <span id="assignRoleNom"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <input type="search" class="form-control mb-2" id="assignQ" placeholder="Rechercher un employé par nom, poste ou service" autocomplete="off">
      <div class="emp-list" id="assignList">
        <% personnes.forEach(p => { const ini = p.nom.split(' ').map(x => x[0] || '').slice(0, 2).join(''); %>
          <label class="emp-row emp-sel" data-q="<%= (p.nom + ' ' + (p.poste || '') + ' ' + (p.service || '') + ' ' + (p.role ? roleLabel(p.role) : 'sans compte')).toLowerCase() %>" data-role="<%= p.role || '' %>" data-compte="<%= p.userId ? 1 : 0 %>" data-actif="<%= p.actif ? 1 : 0 %>" data-email="<%= p.email %>" data-nom="<%= p.nom %>" data-role-label="<%= p.role ? roleLabel(p.role) : '' %>">
            <input type="radio" name="personne" value="<%= p.cle %>" class="form-check-input" required>
            <span class="emp-av"><%= ini %></span>
            <div class="flex-grow-1 min-w-0"><div class="emp-nom"><%= p.nom %></div><small class="text-muted"><%= [p.poste, p.service].filter(Boolean).join(' · ') || 'Sans service' %></small></div>
            <% if (!p.userId) { %><span class="emp-tag emp-tag-off">pas de compte</span>
            <% } else { %><span class="emp-tag <%= p.actif ? '' : 'emp-tag-off' %>" data-tag-role><%= roleLabel(p.role) %><%= p.actif ? '' : ' · désactivé' %></span><% } %>
          </label>
        <% }) %>
        <div class="text-muted small text-center py-3" id="assignVide" hidden>Aucun employé ne correspond.</div>
      </div>
      <div class="assign-detail mt-3" id="assignDetail" hidden>
        <div id="assignAvec" class="small"></div>
        <div id="assignSans" class="row g-2">
          <div class="col-12 small mb-1"><b id="assignSansNom"></b> n'a pas encore de compte. Il pourra se connecter avec :</div>
          <div class="col-12"><label class="form-label">Identifiant de connexion (e-mail)</label><input type="email" name="email" class="form-control" placeholder="prenom.nom@ym-transit.cm" id="assignEmail"></div>
          <div class="col-12"><label class="form-label">Mot de passe provisoire</label><input name="password" class="form-control font-monospace" value="<%= motDePasse %>" minlength="8" data-no-caps id="assignPwd"><div class="form-text">À lui donner : il le changera à sa première connexion.</div></div>
        </div>
      </div>
      <div class="form-text mt-2">La liste contient tous les employés du dossier RH et tous les comptes. Un employé a un seul rôle : l'assigner ici remplace son rôle actuel. Pour quelqu'un qui n'est pas encore employé, utilisez « Créer un collaborateur ».</div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button><button class="btn btn-primary" id="assignOk" disabled><i class="bi bi-check-lg me-1"></i>Assigner</button></div>
  </form></div>
</div>
<script>
  (function () {
    var modal = document.getElementById('assignModal'), q = document.getElementById('assignQ');
    var rows = Array.prototype.slice.call(modal.querySelectorAll('.emp-sel')), roleCible = '', roleNom = '';
    function filtre() {
      var v = q.value.trim().toLowerCase(), n = 0;
      rows.forEach(function (r) { r.hidden = !!v && r.dataset.q.indexOf(v) < 0; if (!r.hidden) n++; });
      document.getElementById('assignVide').hidden = n > 0;
    }
    function choix() {
      var r = rows.find(function (x) { return x.querySelector('input').checked; });
      rows.forEach(function (x) { x.classList.toggle('on', x === r); });
      document.getElementById('assignDetail').hidden = !r;
      document.getElementById('assignOk').disabled = !r;
      if (!r) return;
      var compte = r.dataset.compte === '1';
      document.getElementById('assignSans').hidden = compte;
      document.getElementById('assignAvec').hidden = !compte;
      document.getElementById('assignEmail').required = !compte;
      document.getElementById('assignEmail').disabled = compte;
      document.getElementById('assignPwd').disabled = compte;
      if (compte) {
        var t = r.dataset.role === roleCible ? r.dataset.nom + ' a déjà ce rôle.' : r.dataset.nom + ' passera de <b>' + r.dataset.roleLabel + '</b> à <b>' + roleNom + '</b>.';
        if (r.dataset.actif !== '1') t += ' Son compte désactivé sera réactivé.';
        document.getElementById('assignAvec').innerHTML = '<i class="bi bi-info-circle me-1"></i>' + t + ' Il se connecte avec <b>' + r.dataset.email + '</b>.';
      } else {
        document.getElementById('assignSansNom').textContent = r.dataset.nom;
        document.getElementById('assignEmail').value = r.dataset.email;
      }
    }
    q.addEventListener('input', filtre);
    rows.forEach(function (r) { r.querySelector('input').addEventListener('change', choix); });
    modal.addEventListener('show.bs.modal', function (e) {
      var t = e.relatedTarget; if (!t) return;
      roleCible = t.dataset.role; roleNom = t.dataset.roleLabel;
      document.getElementById('assignRole').value = roleCible;
      document.getElementById('assignRoleNom').textContent = roleNom;
      rows.forEach(function (r) { r.querySelector('input').checked = false; r.style.order = r.dataset.role === roleCible ? 1 : 0; });
      q.value = ''; filtre(); choix();
    });
    modal.addEventListener('shown.bs.modal', function () { q.focus(); });
  })();
</script>
<%- include('../../partials/footer') %>
