<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bulletin de paie · <%= [b.employe.prenom, b.employe.nom].filter(Boolean).join(' ') %> · <%= periodeLabel(b.periode) %></title>
  <style>
    :root { --ink: #0f172a; --muted: #64748b; --line: #e2e8f0; --soft: #f8fafc; --accent: #047857; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #eef2f7; color: var(--ink); font: 13px/1.45 "Inter", system-ui, -apple-system, "Segoe UI", sans-serif; }
    .sheet { max-width: 800px; margin: 24px auto; background: #fff; padding: 32px 36px; border-radius: 12px; box-shadow: 0 10px 30px rgba(15, 23, 42, .08); }
    .bar { max-width: 800px; margin: 16px auto 0; display: flex; gap: 8px; justify-content: flex-end; }
    .bar button, .bar a { font: inherit; padding: 7px 14px; border-radius: 8px; border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; text-decoration: none; }
    .bar button { background: var(--accent); color: #fff; border-color: var(--accent); }
    header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--ink); padding-bottom: 14px; margin-bottom: 16px; }
    header h1 { font-size: 20px; margin: 0; letter-spacing: .02em; }
    header .co b { font-size: 16px; display: block; }
    .muted { color: var(--muted); }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 24px; margin-bottom: 16px; }
    .grid div { display: flex; justify-content: space-between; border-bottom: 1px dotted var(--line); padding: 3px 0; }
    .grid span { color: var(--muted); }
    table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
    th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); border-bottom: 1px solid var(--ink); padding: 6px 4px; }
    td { padding: 5px 4px; border-bottom: 1px solid var(--line); }
    .r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    tr.sub td { background: var(--soft); font-weight: 600; }
    .net { display: flex; justify-content: space-between; align-items: center; background: var(--ink); color: #fff; padding: 12px 16px; border-radius: 10px; font-size: 16px; margin: 6px 0 16px; }
    .net b { font-size: 20px; }
    .foot { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; font-size: 12px; }
    .foot div { background: var(--soft); border-radius: 8px; padding: 8px 10px; }
    .foot b { display: block; font-size: 14px; }
    .sign { display: flex; justify-content: space-between; margin-top: 36px; color: var(--muted); }
    .draft { color: #b45309; background: #fffbeb; border: 1px solid #fde68a; padding: 6px 10px; border-radius: 8px; margin-bottom: 12px; }
    @media print { body { background: #fff; } .bar { display: none; } .sheet { box-shadow: none; margin: 0; max-width: none; border-radius: 0; padding: 0; } }
    @media (max-width: 600px) { .sheet { padding: 18px; margin: 8px; } .grid, .foot { grid-template-columns: 1fr; } header { flex-direction: column; gap: 8px; } }
  </style>
</head>
<body>
<%
  const F = (n) => Math.round(n || 0).toLocaleString('fr-FR');
  const e = b.employe;
  const dl = (x) => x ? new Date(x).toLocaleDateString('fr-FR') : '—';
  const pctl = (x) => String(x).replace('.', ',') + ' %';
  const tx = d.taux || { cnps: 4.2, cac: 10, cfc: 1 };
%>
<div class="bar"><a href="javascript:history.back()">Retour</a><button onclick="window.print()">Imprimer ou enregistrer en PDF</button></div>
<div class="sheet">
  <header>
    <div class="co"><b>YM-TRANSIT</b><span class="muted">Transit & Douane · Douala, Cameroun</span></div>
    <div style="text-align: right"><h1>BULLETIN DE PAIE</h1><div class="muted">Période : <%= periodeLabel(b.periode) %></div></div>
  </header>
  <% if (b.periode.statut === 'BROUILLON') { %><div class="draft">Paie en préparation : ce bulletin n'est pas encore validé.</div><% } %>
  <div class="grid">
    <div><span>Nom</span><b><%= [e.nom, e.prenom].filter(Boolean).join(' ') %></b></div>
    <div><span>Matricule</span><b><%= e.matricule %></b></div>
    <div><span>Poste</span><b><%= e.poste || '—' %></b></div>
    <div><span>Service</span><b><%= e.departement ? e.departement.nom : '—' %></b></div>
    <div><span>Contrat</span><b><%= CONTRATS[e.type_contrat] %><%= e.categorie ? ' · cat. ' + e.categorie : '' %></b></div>
    <div><span>Embauche</span><b><%= dl(e.date_embauche) %></b></div>
    <div><span>N° CNPS</span><b><%= e.cnps_numero || '—' %></b></div>
    <div><span>NIU</span><b><%= e.niu || '—' %></b></div>
  </div>

  <table>
    <thead><tr><th>Rubrique</th><th class="r">Base</th><th class="r">Taux</th><th class="r">Gains</th><th class="r">Retenues</th></tr></thead>
    <tbody>
      <tr><td>Salaire de base</td><td class="r"><%= F(d.base) %></td><td></td><td class="r"><%= F(d.base) %></td><td></td></tr>
      <% if (d.retenue_absence) { %><tr><td>Absences non payées (<%= String(b.jours_absence).replace('.', ',') %> j)</td><td></td><td></td><td></td><td class="r"><%= F(d.retenue_absence) %></td></tr><% } %>
      <% d.primes.forEach(p => { %><tr><td><%= p.libelle %><%= p.imposable ? '' : ' (non imposable)' %></td><td></td><td></td><td class="r"><%= F(p.montant) %></td><td></td></tr><% }) %>
      <tr class="sub"><td>Salaire brut</td><td></td><td></td><td class="r"><%= F(d.brut) %></td><td></td></tr>
      <tr><td>CNPS pension vieillesse</td><td class="r"><%= F(d.cnps_base) %></td><td class="r"><%= pctl(tx.cnps) %></td><td></td><td class="r"><%= F(d.cnps_salarie) %></td></tr>
      <tr><td>IRPP</td><td class="r"><%= F(d.net_imposable_annuel / 12) %></td><td class="r">barème</td><td></td><td class="r"><%= F(d.irpp) %></td></tr>
      <tr><td>Centimes additionnels communaux</td><td class="r"><%= F(d.irpp) %></td><td class="r"><%= pctl(tx.cac) %></td><td></td><td class="r"><%= F(d.cac) %></td></tr>
      <tr><td>Crédit foncier (CFC)</td><td class="r"><%= F(d.brut_imposable) %></td><td class="r"><%= pctl(tx.cfc) %></td><td></td><td class="r"><%= F(d.cfc) %></td></tr>
      <tr><td>Redevance audiovisuelle (RAV)</td><td></td><td></td><td></td><td class="r"><%= F(d.rav) %></td></tr>
      <tr><td>Taxe de développement local (TDL)</td><td></td><td></td><td></td><td class="r"><%= F(d.tdl) %></td></tr>
      <% if (d.avance) { %><tr><td>Avance sur salaire retenue</td><td></td><td></td><td></td><td class="r"><%= F(d.avance) %></td></tr><% } %>
      <tr class="sub"><td>Totaux</td><td></td><td></td><td class="r"><%= F(d.brut) %></td><td class="r"><%= F(d.total_retenues + d.avance) %></td></tr>
    </tbody>
  </table>

  <div class="net"><span>NET À PAYER</span><b><%= F(d.net) %> FCFA</b></div>

  <div class="foot">
    <div><span class="muted">Charges patronales</span><b><%= F(d.employeur.total) %> F</b><span class="muted">CNPS <%= F(d.employeur.pension + d.employeur.af + d.employeur.at) %> · CFC <%= F(d.employeur.cfc) %> · FNE <%= F(d.employeur.fne) %></span></div>
    <div><span class="muted">Paiement</span><b><%= MODES[e.mode_paiement] %></b><span class="muted"><%= e.banque || '' %> <%= e.rib || '' %></span></div>
    <div><span class="muted">Congés payés restants</span><b><%= String(conges.solde).replace('.', ',') %> jours</b><span class="muted"><%= String(conges.acquis).replace('.', ',') %> acquis, <%= String(conges.pris).replace('.', ',') %> pris</span></div>
  </div>
  <div class="sign"><span>L'employeur</span><span>L'employé</span></div>
  <p class="muted" style="font-size: 11px; margin-top: 28px">Conservez ce bulletin sans limitation de durée.</p>
</div>
</body>
</html>
