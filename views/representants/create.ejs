<%- include('../partials/header') %>

<div class="row mb-4 align-items-center">
  <div class="col-sm-6">
    <h1 class="h3 text-slate-800"><i class="bi bi-person-plus-fill text-primary me-2"></i>Nouveau Représentant</h1>
    <p class="text-muted mb-0">Enregistrer un mandataire indépendant et liez-le à ses clients importateurs/exportateurs.</p>
  </div>
  <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
    <a href="/representants" class="btn btn-outline-secondary d-inline-flex align-items-center">
      <i class="bi bi-arrow-left me-2"></i> Retour au Registre
    </a>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 py-3">
        <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-card-list text-primary me-2"></i>Formulaire d'enregistrement</h5>
      </div>
      <div class="card-body p-4">
        <form action="/representants/create" method="POST" enctype="multipart/form-data">
          
          <!-- Section 1 : Informations personnelles -->
          <h6 class="text-primary text-uppercase font-monospace fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">1. Informations Personnelles & Professionnelles</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label small fw-bold">Nom de famille <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="nom" placeholder="Ex: NDEDI" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Prénom(s)</label>
              <input type="text" class="form-control" name="prenom" placeholder="Ex: Jean Paul">
            </div>
            
            <div class="col-md-6">
              <label class="form-label small fw-bold">Numéro de Téléphone</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                <input type="text" class="form-control" name="tel" placeholder="Ex: +237 699 99 99 99">
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Adresse Email</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" class="form-control" name="email" placeholder="Ex: jp.ndedi@gmail.com">
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-bold">N° Carte Nationale d'Identité (CNI)</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                <input type="text" class="form-control" name="cni_numero" placeholder="Ex: 100827391">
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Fonction / Rôle</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                <input type="text" class="form-control" name="fonction" placeholder="Ex: Responsable Transit, Mandataire">
              </div>
            </div>
          </div>

          <!-- Section 2 : Liaison avec des Importateurs/Exportateurs (Clients) -->
          <h6 class="text-primary text-uppercase font-monospace fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">2. Association à des Importateurs / Exportateurs (Clients)</h6>
          <div class="mb-4">
            <label class="form-label small fw-bold d-block mb-2">Sélectionnez les clients représentés par ce mandataire</label>
            <div class="card bg-light border-0">
              <div class="card-body p-3">
                <div class="mb-2">
                  <input type="text" id="clientSearch" class="form-control form-control-sm" placeholder="Rechercher un client dans l'annuaire...">
                </div>
                <div class="overflow-y-auto" style="max-height: 180px;" id="clientsCheckboxesContainer">
                  <% if (clients && clients.length > 0) { %>
                    <% clients.forEach(cl => { %>
                      <div class="form-check py-1 border-bottom border-light-subtle client-checkbox-item" data-name="<%= cl.nom.toLowerCase() %>">
                        <input class="form-check-input" type="checkbox" name="client_ids" value="<%= cl.id %>" id="cl-<%= cl.id %>">
                        <label class="form-check-label small w-100 cursor-pointer" for="cl-<%= cl.id %>">
                          <strong><%= cl.nom %></strong> <span class="text-muted font-monospace text-xs ms-2">(CLI-<%= cl.id %> - NIU: <%= cl.niu || 'N/A' %>)</span>
                        </label>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="text-muted italic small mb-0 p-2">Aucun client disponible dans la base de données.</p>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 3 : Pièces jointes (CNI, Procuration) -->
          <h6 class="text-primary text-uppercase font-monospace fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">3. Pièces Justificatives (Formats: PDF, JPG, PNG — Max: 20Mo)</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="p-3 border rounded bg-light">
                <label class="form-label small fw-bold"><i class="bi bi-file-earmark-person text-primary me-1"></i>CNI du représentant</label>
                <input type="file" class="form-control" name="fichier_cni_rep" accept=".pdf,.png,.jpg,.jpeg">
                <small class="text-muted d-block mt-1">Copie scannée de la Carte Nationale d'Identité.</small>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-3 border rounded bg-light">
                <label class="form-label small fw-bold"><i class="bi bi-file-earmark-text text-primary me-1"></i>Procuration / Mandat</label>
                <input type="file" class="form-control" name="fichier_procu_rep" accept=".pdf,.png,.jpg,.jpeg">
                <small class="text-muted d-block mt-1">Pouvoir ou mandat de transit signé par le client.</small>
              </div>
            </div>
          </div>

          <!-- Boutons d'actions -->
          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <a href="/representants" class="btn btn-light">Annuler</a>
            <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center">
              <i class="bi bi-check-circle me-2"></i> Enregistrer le Représentant
            </button>
          </div>
          
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('clientSearch')?.addEventListener('input', function(e) {
  const query = e.target.value.toLowerCase();
  const items = document.querySelectorAll('.client-checkbox-item');
  items.forEach(item => {
    const name = item.getAttribute('data-name') || '';
    if (name.includes(query)) {
      item.classList.remove('d-none');
    } else {
      item.classList.add('d-none');
    }
  });
});
</script>

<%- include('../partials/footer') %>
