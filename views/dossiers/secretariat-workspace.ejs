<%- include('../partials/header') %>

<div class="row mb-4">
  <div class="col-12 py-2 text-start">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2" style="font-size: 0.85rem;">
        <li class="breadcrumb-item"><a href="/dashboard">Tableau de bord</a></li>
        <li class="breadcrumb-item active" aria-current="page">Espace Secrétariat</li>
      </ol>
    </nav>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h1 class="h3 mb-1 text-slate-800 font-sans fw-bold">
          Espace Secrétariat — Bonjour <%= user.nom %>
        </h1>
        <p class="text-muted mb-0">Gérez vos dossiers de transit étape par étape</p>
      </div>
    </div>
  </div>
</div>

<!-- Three Control Panel Cards -->
<div class="row g-4 mb-5 text-start">
  <!-- CARD 1 — CRÉATION CLIENT -->
  <div class="col-md-4">
    <div class="card h-100 border-0 shadow-sm transition-hover" style="border-top: 4px solid #047857 !important; background-color: #ecfdf5;">
      <div class="card-body d-flex flex-column justify-content-between p-4">
        <div>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title fw-bold font-sans mb-0" style="color: #047857;">Création Client</h5>
            <i class="bi bi-person-plus-fill" style="font-size: 1.8rem; color: #047857;"></i>
          </div>
          <p class="card-text text-slate-700" style="font-size: 0.95rem;">
            Enregistrer un nouveau client avec ses documents d'identité
          </p>
        </div>
        <div class="mt-4">
          <div class="text-slate-500 small mb-3 fw-semibold">
            <i class="bi bi-people me-1"></i><%= totalClients %> clients enregistrés
          </div>
          <a href="/clients/create" class="btn w-full fw-bold text-white shadow-sm d-flex align-items-center justify-content-center gap-2" style="background-color: #047857; border-radius: 8px; padding: 10px 16px;">
            <i class="bi bi-person-plus"></i> Nouveau Client
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- CARD 2 — CRÉATION DOC -->
  <div class="col-md-4">
    <div class="card h-100 border-0 shadow-sm transition-hover" style="border-top: 4px solid #065F46 !important; background-color: #ECFDF5;">
      <div class="card-body d-flex flex-column justify-content-between p-4">
        <div>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title fw-bold font-sans mb-0" style="color: #065F46;">Création Dossier</h5>
            <i class="bi bi-folder-plus" style="font-size: 1.8rem; color: #065F46;"></i>
          </div>
          <p class="card-text text-slate-700" style="font-size: 0.95rem;">
            Ouvrir un nouveau dossier de transit douanier
          </p>
        </div>
        <div class="mt-4">
          <div class="text-slate-500 small mb-3 fw-semibold">
            <i class="bi bi-calendar-check me-1"></i><%= monthDossiersCount %> dossiers transmis au GUCE ce mois
          </div>
          <a href="/dossiers/create" class="btn w-full fw-bold text-white shadow-sm d-flex align-items-center justify-content-center gap-2" style="background-color: #065F46; border-radius: 8px; padding: 10px 16px;">
            <i class="bi bi-folder-plus"></i> Créer un Dossier
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- CARD 3 — LISTE DOC -->
  <div class="col-md-4">
    <div class="card h-100 border-0 shadow-sm transition-hover" style="border-top: 4px solid #7C2D12 !important; background-color: #FFF7ED;">
      <div class="card-body d-flex flex-column justify-content-between p-4">
        <div>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title fw-bold font-sans mb-0" style="color: #7C2D12;">Liste des Dossiers</h5>
            <i class="bi bi-list-ul" style="font-size: 1.8rem; color: #7C2D12;"></i>
          </div>
          <p class="card-text text-slate-700" style="font-size: 0.95rem;">
            Consulter, éditer et modifier vos dossiers
          </p>
        </div>
        <div class="mt-4">
          <div class="text-slate-500 small mb-3 fw-semibold">
            <i class="bi bi-clock-history me-1"></i><%= dossiersCreeCount %> dossiers en cours
          </div>
          <a href="/dossiers/liste" class="btn w-full fw-bold text-white shadow-sm d-flex align-items-center justify-content-center gap-2" style="background-color: #7C2D12; border-radius: 8px; padding: 10px 16px;">
            <i class="bi bi-eye"></i> Voir mes dossiers
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Mes dossiers récents : une ligne = un clic vers le dossier, avec son avancement -->
<div class="card text-start mb-5">
  <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <span><i class="bi bi-clock-history me-2" style="color:var(--accent)"></i>Mes dossiers récents</span>
    <div class="d-flex gap-2">
      <a href="/dossiers?vue=board" class="btn btn-light btn-sm"><i class="bi bi-kanban me-1"></i>Tableau par étape</a>
      <a href="/dossiers/liste" class="btn btn-light btn-sm"><i class="bi bi-list-ul me-1"></i>Tous mes dossiers</a>
    </div>
  </div>
  <div class="list-group list-group-flush">
    <% if (recentDossiers && recentDossiers.length > 0) { %>
      <% recentDossiers.forEach(ds => { const st = stepOf(ds.pipeline_status); %>
        <a href="/dossiers/<%= ds.id %>" class="list-group-item list-group-item-action dossier-row">
          <span class="dr-main">
            <b><%= dossierTitle(ds) %></b>
            <span class="text-muted small text-truncate"><%= dossierSub(ds) %> · <%= new Date(ds.created_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }) %></span>
          </span>
          <%- include('_mini_pipe', { ds }) %>
          <% if (ds.rejet_motif && ds.pipeline_status === 'CREE') { %><span class="badge text-bg-danger" title="<%= ds.rejet_motif %>">Rejeté</span><% } %>
          <span class="stage-pill step-c-<%= st.n %>"><%= st.label %></span>
          <i class="bi bi-chevron-right text-muted"></i>
        </a>
      <% }) %>
    <% } else { %>
      <div class="empty-state py-5"><div class="es-ico"><i class="bi bi-folder2-open"></i></div>Aucun dossier créé pour le moment.</div>
    <% } %>
  </div>
</div>

<style>
.transition-hover {
  transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}
.transition-hover:hover {
  transform: translateY(-3px);
  box-shadow: 0 .5rem 1rem rgba(0,0,0,.08)!important;
}
.btn-xs {
  padding: .2rem .4rem;
  font-size: .75rem;
  border-radius: .2rem;
}
</style>

<%- include('../partials/footer') %>
