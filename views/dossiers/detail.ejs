<script>
  async function workflowConfirmDecaissement(bonReelId) {
    if (!confirm("Confirmer la régularisation ? Le reliquat ou le complément sera inscrit dans la caisse.")) return;
    try {
      const res = await fetch(`/bons/reel/${bonReelId}/confirmer`, { method: "PATCH", headers: { "Content-Type": "application/json" } });
      const data = await res.json();
      if (data.ok) { showToast("C'est fait", data.message, null, 'ok'); if (window.ymLiveRefresh) window.ymLiveRefresh(true); else location.reload(); }
      else showToast('Action impossible', data.message, null, 'err');
    } catch (e) { showToast('Erreur réseau', 'Réessayez.', null, 'err'); }
  }
</script>

