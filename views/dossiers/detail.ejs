<script>
  // Lien direct vers une section (#camcis, #fBae, #finance…) : on ouvre le panneau qui la contient
  (function () {
    function openFor(hash) {
      if (!hash || hash.length < 2) return;
      var el; try { el = document.querySelector(hash); } catch (e) { return; }
      if (!el || !window.bootstrap) return;
      var panel = el.closest('.dsec-panel');
      if (panel && !panel.classList.contains('show')) bootstrap.Collapse.getOrCreateInstance(panel, { toggle: false }).show();
      if (el.classList.contains('collapse') && !el.classList.contains('show')) bootstrap.Collapse.getOrCreateInstance(el, { toggle: false }).show();
      setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 250);
    }
    // « Demander un bon » ouvre directement le formulaire
    var openBonForm = function () { var f = document.getElementById('bonAskForm'); if (f && window.bootstrap) bootstrap.Collapse.getOrCreateInstance(f, { toggle: false }).show(); };
    document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('[data-bon-new]')) openBonForm(); });
    if (location.hash === '#bon-new') openBonForm();
    openFor(location.hash);
    window.addEventListener('hashchange', function () { openFor(location.hash); });
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href^="#"]');
      if (a && a.getAttribute('href').length > 1) setTimeout(function () { openFor(a.getAttribute('href')); }, 0);
    });
    // bouton actif = panneau ouvert
    document.querySelectorAll('.dsec-panel').forEach(function (p) {
      p.addEventListener('show.bs.collapse', function (e) { if (e.target !== p) return; var b = document.querySelector('.dsec-tile[data-bs-target="#' + p.id + '"]'); if (b) { b.classList.remove('collapsed'); b.setAttribute('aria-expanded', 'true'); } });
      p.addEventListener('hide.bs.collapse', function (e) { if (e.target !== p) return; var b = document.querySelector('.dsec-tile[data-bs-target="#' + p.id + '"]'); if (b) { b.classList.add('collapsed'); b.setAttribute('aria-expanded', 'false'); } });
      if (p.classList.contains('show')) { var b = document.querySelector('.dsec-tile[data-bs-target="#' + p.id + '"]'); if (b) { b.classList.remove('collapsed'); b.setAttribute('aria-expanded', 'true'); } }
    });
  })();
</script>


